# BlimpMate Project Environment Variables
# Copy this file to .env (or .env.local) and fill in the secrets that apply.
# Never commit a populated .env file to source control.

# --- Xiaozhi (conversation API) ---
# Optional backend preset (desktop only). There is no built-in default server:
# a backend saved from the app (first-run dialog or Chat panel > Backend) wins,
# then these vars; with neither, the app asks on first launch.
#   BM_XIAOZHI_WS_URL (+ optional BM_XIAOZHI_WS_TOKEN): connect directly.
#   BM_XIAOZHI_OTA_URL: ask that OTA endpoint for the websocket (may require
#   device binding; `npm run xiaozhi:activate -- <ota-url>` does it from a CLI).
# If both are set, the websocket URL is used.
BM_XIAOZHI_OTA_URL=
BM_XIAOZHI_WS_URL=
BM_XIAOZHI_WS_TOKEN=

# --- Host Service ---
BM_HOST_SERVICE_HOST=127.0.0.1
BM_HOST_SERVICE_PORT=5050
BM_HOST_SERVICE_BASE_URL=http://127.0.0.1:5050
BM_CAMERA_INDEX=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Vision (Agent A) ---
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-vl-flash

# --- Media (Agent B) ---
YOUTUBE_API_KEY=
YOUTUBE_USE_PROXY=0
YOUTUBE_PROXY_URL=http://127.0.0.1:7890
NCM_COOKIE=
NCM_SESSION_FILE=
PLAYLIST_FILE=

# --- Flight (Agent E) ---
# Production flight topology (see ORANGEPI_DEPLOYMENT.md):
#   PC host-service setpoints -> Android thin bridge -> MSP-over-UART -> GN405 running INAV.
# Production actuation is MSP virtual-RC setpoints (MSP_SET_RAW_RC), NOT CLI motor commands.
# The legacy CLI motor path is props-off bench-only and stays fenced off by default.
BM_FLIGHT_MOCK=true
#
# --- host-service daemon (PC) knobs — consumed by host-service/flight/daemon.py ---
# Production MSP serial port the daemon opens. This is the ONLY production link
# the capabilities flight gate recognizes. Unset / "mock://msp" => mock (no FC).
# NOTE: the legacy BM_BETAFLIGHT_PORT is NOT honoured here — it is the bench-only
# CLI path (host-service/flight/betaflight_serial.py), never production actuation.
# BM_MSP_PORT=mock://msp
# BM_MSP_BAUD=115200
# MSP virtual-RC setpoint publish rate. 25-50 Hz; INAV needs valid MSP RC at >=5 Hz.
# BM_MSP_SETPOINT_HZ=50
# In-process software-hygiene watchdog timeout (NOT the safety boundary; the FC is).
# BM_FLIGHT_WATCHDOG_S=1.5
# MTF-01 telemetry source. Default mock://mtf01 (re-homed off the PC /dev/ttyAMA2
# pretense). A real PC serial also needs BM_MTF01_ALLOW_PC_SERIAL=1 in the sensor.
# BM_MTF01_PORT=mock://mtf01
#
# --- Android bridge (Orange Pi) knobs — consumed when the page constructs
#     createFcSerialBridge() / createAndroidFcSerialTransport() in
#     src/shared-web/flight/fc-serial-bridge.mjs; pass these from the Android
#     deployment config into those calls (path -> open(), ms -> deadlineMs) ---
# Android-side UART node the bridge opens. Orange Pi Zero3W / Android 13: /dev/ttyAS2.
# BM_ANDROID_MSP_UART=/dev/ttyAS2
# Bridge command-freshness deadline. On timeout the bridge sends ONE configured
# disarm frame then goes silent (latched); recovery needs an explicit disarmed
# control frame, so the GN405/INAV RX-loss failsafe owns the event.
# BM_MSP_COMMAND_DEADLINE_MS=200
#
# Explicit opt-in to re-enable the RETIRED bench CLI motor path on a REAL serial port
# (props off, bench only). Leave unset/false for production; mock mode never needs it.
# BM_ALLOW_BENCH_CLI_MOTOR=0

# --- Wake word (Agent D) ---
# The WebView owns the only microphone stream and sends 16 kHz PCM to Sherpa.
# Python performs inference only and never opens an audio device.
# Real Sherpa-ONNX KWS is the desktop default. Set MOCK=true only for tests:
#   pip install sherpa-onnx   (already in requirements.lock.txt)
#   model -> host-service/data/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/
# The committed keywords.en.txt contains "Hey Blimp". Override with an
# absolute keyword file only when deploying another phrase/model.
BM_WAKE_WORD_ENABLED=1
BM_HOST_SERVICE_AUTOSTART=1
BM_SHERPA_MODEL_DIR=
BM_SHERPA_KEYWORDS_FILE=

# --- Autonomous positioning / multi-user (review R2/R3) ---
# Set to 1 to use real camera-based user localization (needs OpenCV + a working
# camera, i.e. Orange Pi / Phase D). Default (unset) = mock target + simulated
# motion so the follow loop is demonstrable without a camera.
BM_NAV_USE_CAMERA=

# --- Vision data dir (advanced blueprint) ---
BM_VISION_DATA_DIR=

# --- Electron host (renderer / display server) ---
BM_DISPLAY_PORT=8787
BM_DISPLAY_URL=

# --- PC->Pi display streaming (Stage 3) ---
# Set BM_DISPLAY_STREAM=1 on the ground PC to capture the Electron mainWindow and
# stream it (WebRTC) to the Pi /display receiver. NOTE: capturing mainWindow
# includes the operator UI (intentional v1). Capture is video-only, 720p/15fps.
BM_DISPLAY_STREAM=
BM_DISPLAY_WIDTH=1280
BM_DISPLAY_HEIGHT=720
BM_DISPLAY_FPS=15
BM_DISPLAY_SESSION_ID=
BM_DISPLAY_SENDER_ID=
BM_DISPLAY_RECEIVER_ID=
BM_HOST_SERVICE_TIMEOUT_MS=10000
BM_11_25_BASE_URL=
BM_CONTROLLER_BASE_URL=
BM_CONTROLLER_HOST=

# --- Review provenance / audit ---
# system.get_capabilities and GET /capabilities report canonical provenance:
# real | fallback | mock | manual/Wizard-of-Oz. Set explicit acknowledgements
# only when the corresponding hardware/API path has been verified.
BM_CAMERA_REAL=0
BM_CAMERA_DEVICE=
BM_CALL_REAL=0
BM_TELEMETRY_RETENTION_DAYS=30
BM_SCENARIO_AUDIT_RETENTION_DAYS=30

# --- Debug ---
# Set to ISO date (e.g. 2026-02-05) to force date-dependent code to a fixed value.
# Leave empty in production.
BM_DEBUG_FORCE_DATE=

# Public website digital-twin API
# Audit is operator-controlled; browser payloads cannot opt in.
BM_WEB_EXPERIENCE_AUDIT=0
BM_WEB_EXPERIENCE_MAX_IMAGE_BYTES=6000000
BM_WEB_EXPERIENCE_MAX_REQUEST_BYTES=8500000
