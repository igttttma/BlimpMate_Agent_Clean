<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <!-- The CA that signs the stream servers' certificates (stream-server's
                 `npm run cert`), copied at build time from src/certs/stream-server-ca.pem.
                 Any server with a certificate from this CA is trusted; no rebuild per server. -->
            <certificates src="@raw/stream_server_ca"/>
        </trust-anchors>
    </base-config>
</network-security-config>
