<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
            <!-- The stream server's self-signed certificate, copied at build time from
                 the Blimp app (app/src/main/res/raw/stream_server_cert.pem). -->
            <certificates src="@raw/stream_server_cert"/>
        </trust-anchors>
    </base-config>
</network-security-config>
